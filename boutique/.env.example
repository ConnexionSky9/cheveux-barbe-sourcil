# =====================================================================
#  Boutique Elyzea — configuration (copier en .env, ne JAMAIS publier le .env)
#  Le fichier .env est lu depuis backend/ ou depuis ce dossier.
# =====================================================================

NODE_ENV=production
PORT=3000
# Adresse publique du site (https obligatoire en production, sans / final)
PUBLIC_URL=https://boutique.exemple.fr
# Nombre de proxys devant l'API (Nginx/Caddy = 1, Cloudflare + Nginx = 2). 0 si accès direct.
TRUST_PROXY=1
# Cookies « Secure » (HTTPS). Mettre false UNIQUEMENT en local sur http://localhost
COOKIE_SECURE=true

# Base MySQL / MariaDB dédiée à la boutique (utilisateur avec droits sur cette base seulement)
DATABASE_URL=mysql://boutique:MOT_DE_PASSE@127.0.0.1:3306/elyzea_boutique

# Affichage
SERVER_NAME=Elyzea
CURRENCY=EUR
DISCORD_URL=
SUPPORT_EMAIL=

# --- Tebex (panneau Tebex › Integrations / Webhooks) ---
# Identifiant public de la boutique (« Public token / Webstore identifier » de l'API Headless)
TEBEX_PUBLIC_TOKEN=
# Clé privée Headless : facultative, utilisée seulement côté serveur
TEBEX_PRIVATE_KEY=
# Secret des webhooks (panneau Tebex › Webhooks › votre endpoint) — 16 caractères minimum
TEBEX_WEBHOOK_SECRET=
# IP autorisées à envoyer les webhooks (séparées par des virgules). Vide = contrôle désactivé.
# Vérifiez la liste à jour dans la documentation Tebex avant de l'activer.
TEBEX_WEBHOOK_IPS=

# --- Serveur de jeu FiveM ---
# Jeton partagé avec la ressource server_shop (au moins 32 caractères aléatoires) :
#   openssl rand -hex 32
GAME_SERVER_TOKEN=
# IP publiques du serveur FiveM autorisées (facultatif, recommandé)
GAME_SERVER_IPS=

# Livraison : nombre d'essais avant de marquer une livraison « échouée »
DELIVERY_MAX_ATTEMPTS=8
# Dossier du site compilé, relatif au dossier backend/
WEB_DIST=../web/dist
